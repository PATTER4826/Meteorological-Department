# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000
NODE_ENV=production

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/thai_disaster_db?schema=public"

# Cache & Queue (Redis)
REDIS_URL="redis://localhost:6379"

# Discord Bot Integration
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""
DISCORD_WEBHOOK_CRITICAL=""
DISCORD_WEBHOOK_WEATHER=""
DISCORD_WEBHOOK_EARTHQUAKE=""
DISCORD_WEBHOOK_FLOOD=""
DISCORD_WEBHOOK_PM25=""

# External API Keys (Optional overrides, open APIs used by default)
WEATHER_API_KEY=""
TMD_API_KEY=""
AIR4THAI_API_KEY=""

# Data Polling Intervals (milliseconds)
POLL_INTERVAL_EARTHQUAKE=60000
POLL_INTERVAL_WEATHER=180000
POLL_INTERVAL_AIR_QUALITY=300000
POLL_INTERVAL_FLOOD=300000

